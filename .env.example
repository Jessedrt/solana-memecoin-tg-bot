# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=

# Random secrets
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
SCANNER_SECRET=replace_with_another_random_secret
SETUP_SECRET=replace_with_setup_secret

# Optional explicit production URL, e.g. https://your-project.vercel.app
PUBLIC_BASE_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash
QSTASH_TOKEN=
SCAN_CRON=*/2 * * * *
QSTASH_SCHEDULE_ID=solana-memecoin-scanner

# Scanner filters
MAX_AGE_MINUTES=90
MIN_MCAP_USD=4000
MAX_MCAP_USD=350000
MIN_REPLIES=2
MIN_SCORE=55
REQUIRE_STILL_ON_CURVE=true
REQUIRE_SOCIALS=false
ALERT_COOLDOWN_MINUTES=180
MAX_TOKENS_TO_ENRICH=10

# Local/VPS runner only
SCAN_INTERVAL_SECONDS=30
