# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=

# Random secrets
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
SCANNER_SECRET=replace_with_another_random_secret
SETUP_SECRET=replace_with_setup_secret

# Optional explicit production URL, e.g. https://your-project.vercel.app
PUBLIC_BASE_URL=

# Redis: use either a normal Redis connection URL OR the Upstash REST pair.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash
QSTASH_TOKEN=
SCAN_CRON=*/2 * * * *
QSTASH_SCHEDULE_ID=solana-memecoin-scanner

# Alert performance tracking
PERFORMANCE_REFRESH_SECONDS=300
REPORT_TZ_OFFSET_HOURS=1

# Deep due diligence (required for alerts by default)
# Create a key at Solana Tracker Data API and add it here.
SOLANA_TRACKER_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REQUIRE_DEEP_DD=true
MAX_BUNDLER_PCT=15
CHEAP_ENTRY_MCAP_USD=10000
MAX_CHEAP_UNSOLD_TOP10_COUNT=3
MAX_CHEAP_UNSOLD_TOP10_PCT=10
SERIAL_DEV_LAUNCHES_24H=4

# Scanner filters
MAX_AGE_MINUTES=90
MIN_MCAP_USD=4000
MAX_MCAP_USD=350000
MIN_REPLIES=2
MIN_SCORE=55
REQUIRE_STILL_ON_CURVE=true
REQUIRE_SOCIALS=false
ALERT_COOLDOWN_MINUTES=180
MAX_TOKENS_TO_ENRICH=10
GECKO_NEW_POOL_PAGES=2

# Local/VPS runner only
SCAN_INTERVAL_SECONDS=30

# Pulse candidate engine (all optional; defaults shown)
PULSE_MIN_AGE_MINUTES=5
PULSE_MAX_AGE_MINUTES=360
PULSE_MIN_MCAP_USD=20000
PULSE_MAX_MCAP_USD=500000
PULSE_PREFERRED_LIQUIDITY_USD=8000
PULSE_CRITICAL_LIQUIDITY_USD=2000
PULSE_MAX_CREATOR_PCT=20
PULSE_MAX_RELATED_WALLETS_PCT=35
PULSE_MAX_TOP10_PCT=60
PULSE_MAX_LARGEST_HOLDER_PCT=30
PULSE_MAX_BUNDLE_PCT=30
PULSE_MAX_SNIPER_PCT=25
PULSE_STALE_SECONDS=300
PULSE_CONFLICT_RATIO=0.25
PULSE_ALERT_MIN_SCORE=65
PULSE_STRONG_WATCH_SCORE=75
PULSE_HIGH_CONVICTION_SCORE=85
PULSE_REALERT_SCORE_DELTA=10
PULSE_MAX_CANDIDATES=12
PULSE_WEIGHT_SAFETY=30
PULSE_WEIGHT_WALLET=20
PULSE_WEIGHT_MOMENTUM=15
PULSE_WEIGHT_LIQUIDITY=15
PULSE_WEIGHT_EARLY=10
PULSE_WEIGHT_SOCIAL=10

