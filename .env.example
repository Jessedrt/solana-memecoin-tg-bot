# Required: create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Optional. If empty, the bot DMs whoever sends /start
# Get your numeric id from @userinfobot
TELEGRAM_CHAT_ID=

# How often to scan (seconds). 25-45 is a good range.
SCAN_INTERVAL_SECONDS=30

# Only alert tokens younger than this
MAX_AGE_MINUTES=90

# USD market cap window — skip dust and skip already-pumped coins
MIN_MCAP_USD=4000
MAX_MCAP_USD=350000

# Minimum Pump.fun chat replies (social heat)
MIN_REPLIES=2

# Minimum potential score (0-100) before an alert fires
MIN_SCORE=55

# Skip tokens already graduated off the bonding curve
REQUIRE_STILL_ON_CURVE=true

# Skip tokens with no X or Telegram link
REQUIRE_SOCIALS=false

# Do not re-alert the same mint for this many minutes
ALERT_COOLDOWN_MINUTES=180
